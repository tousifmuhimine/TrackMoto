# Database URL (Neon Postgres Cloud or Local Docker)
DATABASE_URL="postgresql://trackmoto:replace-with-a-strong-password@localhost:5432/trackmoto?schema=public"
DATABASE_URL_UNPOOLED="postgresql://trackmoto:replace-with-a-strong-password@localhost:5432/trackmoto?schema=public"

# Neon Branch & Services
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_REALTIME_URL="wss://ep-xxxx.rt.c-6.us-east-2.aws.neon.tech/"
NEON_REALTIME_SECRET=""

# Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-6.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"

# Functions
NEON_FUNCTION_HELLO_BASE_URL="https://br-xxxx-hello.compute.c-6.us-east-2.aws.neon.tech"

# App
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXT_PUBLIC_APP_NAME="TrackMoto"
